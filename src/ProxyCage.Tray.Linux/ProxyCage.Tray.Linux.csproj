<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProxyCage.Core\ProxyCage.Core.csproj" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cehoproxy-tray</AssemblyName>
    <AssemblyTitle>CehoProxy</AssemblyTitle>
    <Product>CehoProxy</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../assets/tray/cehoproxy-tray-*.png" LogicalName="cehoproxy.tray.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
